# AWS region — must support Amazon Bedrock
AWS_REGION=us-east-1

# AWS credentials (leave blank if using IAM role — recommended for production)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# Bedrock model IDs (via LiteLLM bedrock/ prefix)
SUPERVISOR_MODEL=bedrock/anthropic.claude-sonnet-4-5
RAG_MODEL=bedrock/anthropic.claude-sonnet-4-5
ACTION_MODEL=bedrock/anthropic.claude-sonnet-4-5
POLICY_MODEL=bedrock/anthropic.claude-opus-4-5

# Bedrock Knowledge Base (required for RAG — create in AWS Console -> Bedrock -> Knowledge Bases)
KNOWLEDGE_BASE_ID=your-knowledge-base-id

# Bedrock Guardrails (optional — leave blank to skip content filtering)
GUARDRAIL_ID=your-guardrail-id
GUARDRAIL_VERSION=DRAFT

# AWS Secrets Manager namespace prefix (secrets stored as <namespace>/<name>)
SECRETS_NAMESPACE=enterprise-agent

# Application
APP_NAME=enterprise-multi-agent-aws
LOG_LEVEL=INFO
