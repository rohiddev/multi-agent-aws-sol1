# AWS configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key        # leave blank if using IAM role (recommended)
AWS_SECRET_ACCESS_KEY=your-secret-key    # leave blank if using IAM role (recommended)

# Bedrock model IDs (via LiteLLM)
SUPERVISOR_MODEL=bedrock/anthropic.claude-sonnet-4-5
RAG_MODEL=bedrock/anthropic.claude-sonnet-4-5
ACTION_MODEL=bedrock/anthropic.claude-sonnet-4-5
POLICY_MODEL=bedrock/anthropic.claude-opus-4-5

# Bedrock Knowledge Base
KNOWLEDGE_BASE_ID=your-knowledge-base-id

# Bedrock Guardrails
GUARDRAIL_ID=your-guardrail-id
GUARDRAIL_VERSION=DRAFT

# Application
APP_NAME=enterprise-multi-agent-aws
LOG_LEVEL=INFO
